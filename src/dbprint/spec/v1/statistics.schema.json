    "TableUnmeasured": {
      "description": "SPEC 2.2.1: the table-level twin, restricted to the three blocks whose absence is otherwise a positive claim. `grain` is excluded (required, and `search.exhausted` already carries the partial case) and so is `depends_on` (its absence already means the producer could not ask).",
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "physical_layout",
          "null_patterns",
          "dependencies"
        ]
      }
    },
    "Unmeasured": {
      "description": "SPEC 2.2.4 / 2.2.1: names the fields (or table-level blocks) this run attempted and could not obtain. Every named entry MUST be absent from the same object - which no schema keyword can express against a name list, so the conformance validator carries that half. Its presence relaxes the classification branch's own required list to the five fields REQUIRED on every classification, since which of the rest it excuses is that same name list. Omitted entirely when nothing failed.",
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
