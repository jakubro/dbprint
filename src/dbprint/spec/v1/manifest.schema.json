{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jakubro.github.io/dbprint/spec/v1/manifest.schema.json",
  "title": "dbprint manifest.yaml v1",
  "description": "Per-connection table index. See SPEC.md section 2.5.",
  "type": "object",
  "required": [
    "format_version",
    "generated_at",
    "connection",
    "adapter",
    "dbprint_version",
    "profile",
    "selectors",
    "redaction_rules_configured",
    "default_collation",
    "tables"
  ],
  "properties": {
    "format_version": {"const": 1},
    "generated_at": {"$ref": "#/$defs/UtcIso8601"},
    "connection": {"type": "string", "minLength": 1},
    "adapter": {"type": "string", "minLength": 1},
    "dbprint_version": {"type": "string", "minLength": 1},
    "profile": {"$ref": "#/$defs/Profile"},
    "selectors": {"$ref": "#/$defs/Selectors"},
    "redaction_rules_configured": {"type": "integer", "minimum": 0},
    "default_collation": {"type": "string", "minLength": 1},
    "failed_tables": {
      "description": "Tables the writing run attempted and could not profile, sorted; omitted when empty. See SPEC.md section 2.5.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "manifest_annotations": {"const": "manifest.annotations.yaml"},
    "tables": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/TableEntry"}
    }
  },
  "$defs": {
    "UtcIso8601": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "Profile": {
      "description": "The connection's resolved profile for this run, every block present, without freshness or redaction. See SPEC.md section 2.5.",
      "$ref": "#/$defs/ProfileOverride",
      "required": ["read", "statistics", "looks_like", "null_patterns", "parts", "timeline", "sketches", "relationships"],
      "properties": {
        "read": {"required": ["tables", "views"]}
      }
    },
    "ProfileOverride": {
      "description": "The blocks of a table's resolved profile that differ from the connection's, each whole. See SPEC.md section 2.5.",
      "type": "object",
      "properties": {
        "read": {
          "type": "object",
          "properties": {
            "tables": {"$ref": "#/$defs/ReadBlock"},
            "views": {"$ref": "#/$defs/ReadBlock"}
          }
        },
        "statistics": {
          "type": "object",
          "required": ["enumeration_threshold", "top_n_values", "percentiles"],
          "properties": {
            "enumeration_threshold": {"type": "integer", "minimum": 1},
            "top_n_values": {"type": "integer", "minimum": 1},
            "percentiles": {
              "type": "array",
              "items": {"type": "integer", "minimum": 1, "maximum": 99}
            }
          }
        },
        "looks_like": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "sample_size": {"type": "integer", "minimum": 1}
          },
          "if": {"properties": {"enabled": {"const": true}}},
          "then": {"required": ["sample_size"]}
        },
        "null_patterns": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "top_n": {"type": "integer", "minimum": 1}
          },
          "if": {"properties": {"enabled": {"const": true}}},
          "then": {"required": ["top_n"]}
        },
        "parts": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "max": {"type": "integer", "minimum": 1},
            "max_depth": {"type": "integer", "minimum": 1}
          },
          "if": {"properties": {"enabled": {"const": true}}},
          "then": {"required": ["max", "max_depth"]}
        },
        "timeline": {
          "type": "object",
          "required": ["enabled"],
          "properties": {"enabled": {"type": "boolean"}}
        },
        "sketches": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "columns": {"enum": ["required", "all"]}
          },
          "if": {"properties": {"enabled": {"const": true}}},
          "then": {"required": ["columns"]}
        },
        "relationships": {
          "type": "object",
          "required": ["infer"],
          "properties": {"infer": {"type": "boolean"}}
        }
      }
    },
    "ReadBlock": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["full", "sample", "filter", "catalog"]},
        "fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "max_rows": {"type": "integer", "minimum": 1},
        "materialize": {"type": "boolean"},
        "filter": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "sample"}}},
          "then": {
            "required": ["materialize"],
            "not": {"required": ["fraction", "max_rows"]},
            "if": {"not": {"required": ["max_rows"]}},
            "then": {"required": ["fraction"]}
          }
        },
        {
          "if": {"properties": {"mode": {"const": "filter"}}},
          "then": {"required": ["filter"]}
        }
      ]
    },
    "Selectors": {
      "type": "object",
      "required": ["include", "exclude"],
      "properties": {
        "include": {"type": "array", "items": {"type": "string"}},
        "exclude": {"type": "array", "items": {"type": "string"}}
      }
    },
    "TableEntry": {
      "type": "object",
      "required": ["type", "path", "artifacts", "columns", "profiled_at"],
      "properties": {
        "type": {"enum": ["table", "view", "matview"]},
        "path": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9_][a-z0-9_-]*(/[a-z0-9_][a-z0-9_-]*)*$"},
        "artifacts": {"$ref": "#/$defs/Artifacts"},
        "row_count": {"type": "integer", "minimum": 0},
        "columns": {"type": "integer", "minimum": 0},
        "profiled_at": {"$ref": "#/$defs/UtcIso8601"},
        "max_age_days": {"type": "integer", "minimum": 0},
        "profile": {"$ref": "#/$defs/ProfileOverride"},
        "max_rows_scanned": {"type": "integer", "minimum": 1}
      }
    },
    "Artifacts": {
      "type": "object",
      "required": ["ddl"],
      "properties": {
        "ddl": {"const": "ddl.sql"},
        "statistics": {"const": "statistics.yaml"},
        "relationships": {"const": "relationships.yaml"},
        "description": {"const": "description.md"},
        "statistics_annotations": {"const": "statistics.annotations.yaml"},
        "relationships_annotations": {"const": "relationships.annotations.yaml"}
      }
    }
  }
}
