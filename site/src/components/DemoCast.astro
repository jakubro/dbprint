---
// The landing page's terminal recording. `site/public/demo.cast` is generated by `just demo`,
// and the player is loaded from a CDN at a pinned version with an integrity hash.
const { castUrl, playerVersion, scriptIntegrity, styleIntegrity } = Astro.props;
const base = `https://cdn.jsdelivr.net/npm/asciinema-player@${playerVersion}/dist/bundle`;
---

<link
  rel="stylesheet"
  href={`${base}/asciinema-player.css`}
  integrity={styleIntegrity}
  crossorigin="anonymous"
/>

<figure class="demo-cast">
  <div id="demo-cast-player" data-cast-url={castUrl}></div>
</figure>

<script
  is:inline
  src={`${base}/asciinema-player.min.js`}
  integrity={scriptIntegrity}
  crossorigin="anonymous"
></script>

<script is:inline>
  // Deferred to load: the bundle is not a module, so `AsciinemaPlayer` appears on `window` only
  // once it executes; an integrity failure leaves it undefined and the container stays empty.
  window.addEventListener("load", () => {
    const container = document.getElementById("demo-cast-player");

    if (!container || typeof window.AsciinemaPlayer === "undefined") return;

    window.AsciinemaPlayer.create(container.dataset.castUrl, container, {
      autoPlay: true,
      loop: true,
      fit: "width",
      terminalFontSize: "13px",
    });
  });
</script>

<style>
  .demo-cast {
    margin: 0 0 2rem;
  }

  .demo-cast figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
